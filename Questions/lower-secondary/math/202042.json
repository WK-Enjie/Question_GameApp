    {
      "question": "Expand and simplify: (√(a) + √(b))^2 - (√(a) - √(b))^2",
      "options": [
        "4√(ab)",
        "2a + 2b",
        "4ab",
        "a + b"
      ],
      "correct": 0,
      "points": 18,
      "explanation": "(√(a) + √(b))^2 = a + 2√(ab) + b. (√(a) - √(b))^2 = a - 2√(ab) + b. Subtracting: (a + 2√(ab) + b) - (a - 2√(ab) + b) = 4√(ab)"
    },
    {
      "question": "Given that x^2 + y^2 = 20 and (x - y)^2 = 8, find the value of xy.",
      "options": [
        "4",
        "6",
        "8",
        "12"
      ],
      "correct": 1,
      "points": 18,
      "explanation": "Using (x - y)^2 = x^2 - 2xy + y^2. So 8 = (x^2 + y^2) - 2xy = 20 - 2xy. Therefore 2xy = 20 - 8 = 12, so xy = 6"
    }
  ]
