    {
      "question": "Simplify: (8x⁶y⁹)^(2/3)",
      "options": [
        "4x⁴y",
        "8xy⁶",
        "4x⁹y¹³·⁵",
        "2x⁴y⁶"
      ],
      "correct": 0,
      "points": 20,
      "explanation": "(8x⁶y⁹)^(2/3) = 8^(2/3) × x⁶ˣ²/³⁾ × y⁹ˣ⁽²/³⁾ = (2³)^(2/3) × x⁴ × y⁶ = 2² × x⁴ × y⁶ = 4x⁴y⁶"
    },
    {
      "question": "Simplify: 3^(2x) × 9^x ÷ 27^(x-1)",
      "options": [
        "3^(x+3)",
        "3^(3x+3)",
        "3^(3x-3)",
        "27"
      ],
      "correct": 1,
      "points": 25,
      "explanation": "Convert to base 3: 3^(2x) × (3²)^x ÷ (3³)^(x-1) = 3^(2x) × 3^(2x) ÷ 3^(3x-3) = 3^(2x+2x-(3x-3)) = 3^(4x-3x+3) = 3^(x+3)"
    },
    {
      "question": "Solve: 2^(x+1) + 2^x = 24",
      "options": [
        "2",
        "3",
        "4",
        "5"
      ],
      "correct": 1,
      "points": 25,
      "explanation": "2^(x+1) + 2^x = 2^x × 2¹ + 2^x = 2^x(2+1) = 3 × 2^x = 24. So 2^x = 8 = 2³, therefore x = 3"
    },
    {
      "question": "Simplify: (16^(3/4) × 8^(2/3)) / 4^(1/2)",
      "options": [
        "8",
        "16",
        "32",
        "64"
      ],
      "correct": 1,
      "points": 20,
      "explanation": "16^(3/4) = (2⁴)^(3/4) = 2³ = 8; 8^(2/3) = (2³)^(2/3) = 2² = 4; 4^(1/2) = 2. So (8 × 4) / 2 = 32/2 = 16"
    },
    {
      "question": "Solve for x: 4^x - 6(2^x) + 8 = 0",
      "options": [
        "x = 1 only",
        "x = 2 only",
        "x = 1 or x = 2",
        "x = 2 or x = 3"
      ],
      "correct": 2,
      "points": 30,
      "explanation": "Let y = 2^x, then 4^x = (2²)^x = (2^x)² = y². Equation becomes: y² - 6y + 8 = 0. Factorise: (y-2)(y-4) = 0. So y = 2 or y = 4. When y = 2: 2^x = 2, x = 1. When y = 4: 2^x = 4, x = 2"
    },
    {
      "question": "If 3^x = 5, find the value of 3^(2x+1)",
      "options": [
        "25",
        "50",
        "75",
        "125"
      ],
      "correct": 2,
      "points": 25,
      "explanation": "3^(2x+1) = 3^(2x) × 3¹ = (3^x)² × 3 = 5² × 3 = 25 × 3 = 75"
    },
    {
      "question": "Simplify: √(75x⁸y¹⁵)",
      "options": [
        "5x⁴y⁷√(3y)",
        "5x⁴y⁷√3",
        "25x⁴y⁷√(3y)",
        "5x⁴y⁷·⁵√3"
      ],
      "correct": 0,
      "points": 20,
      "explanation": "√(75x⁸y¹⁵) = √(25 × 3 × x⁸ × y¹⁴ × y) = √25 × √3 × √x⁸ × √y¹⁴ × √y = 5 × √3 × x⁴ × y⁷ × √y = 5x⁴y⁷√(3y)"
    },
    {
      "question": "Solve: 9^(x-1) = 27^(2x+1)",
      "options": [
        "-1",
        "-5/4",
        "-3/2",
        "-2"
      ],
      "correct": 1,
      "points": 25,
      "explanation": "Convert to base 3: (3²)^(x-1) = (3³)^(2x+1). So 3^(2x-2) = 3^(6x+3). Therefore 2x-2 = 6x+3. Rearranging: -2-3 = 6x-2x. -5 = 4x. x = -5/4"
    },
    {
      "question": "If 2^a = 3 and 3^b = 5, express 5^(2a) in terms of b",
      "options": [
        "3^(2ab)",
        "9^b",
        "3^(2b)",
        "2^(3ab)"
      ],
      "correct": 0,
      "points": 30,
      "explanation": "5^(2a) = (3^b)^(2a) = 3^(2ab). Since 2^a = 3, we can also write this as (2^a)^(2ab) = 2^(a×2ab), but 3^(2ab) is the simplest form in terms of the given information"
    },
    {
      "question": "Simplify completely: (x^(1/2) + x^(-1/2))²",
      "options": [
        "x + 1/x",
        "x + 2 + 1/x",
        "x² + 2 + 1/x²",
        "x + 1"
      ],
      "correct": 1,
      "points": 25,
      "explanation": "(x^(1/2) + x^(-1/2))² = (x^(1/2))² + 2(x^(1/2))(x^(-1/2)) + (x^(-1/2))² = x¹ + 2x⁰ + x^(-1) = x + 2(1) + 1/x = x + 2 + 1/x"
    }
  ]
