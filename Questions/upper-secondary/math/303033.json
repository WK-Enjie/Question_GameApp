  "questions": [
    {
      "question": "Calculate the simple interest on $2,000 invested for 3 years at 5% per annum.",
      "options": [
        "$200",
        "$300",
        "$400",
        "$500"
      ],
      "correct": 1,
      "points": 10,
      "explanation": "Simple Interest = P x R x T / 100 = 2000 x 5 x 3 / 100 = $300"
    },
    {
      "question": "A sum of $5,000 is invested at 4% per annum simple interest. What is the total amount after 2 years?",
      "options": [
        "$5,600",
        "$5,200",
        "$5,800",
        "$5,400"
      ],
      "correct": 3,
      "points": 10,
      "explanation": "Interest = 5000 x 4 x 2 / 100 = $400. Total Amount = $5,000 + $400 = $5,400"
    },
    {
      "question": "Find the compound interest on $1,000 invested for 2 years at 10% per annum compounded annually.",
      "options": [
        "$210",
        "$200",
        "$1,210",
        "$220"
      ],
      "correct": 0,
      "points": 12,
      "explanation": "A = P(1 + r/100)^n = 1000(1.1)^2 = 1000 x 1.21 = $1,210. Compound Interest = $1,210 - $1,000 = $210"
    },
    {
      "question": "What is the difference between simple interest and compound interest on $2,000 for 2 years at 5% per annum?",
      "options": [
        "$10",
        "$15",
        "$5",
        "$20"
      ],
      "correct": 2,
      "points": 15,
      "explanation": "SI = 2000 x 5 x 2 / 100 = $200. CI = 2000(1.05)^2 - 2000 = $2,205 - $2,000 = $205. Difference = $205 - $200 = $5"
    },
    {
      "question": "If $3,000 is invested at 6% per annum compounded annually, what is the amount after 3 years?",
      "options": [
        "$3,540.00",
        "$3,600.00",
        "$3,650.00",
        "$3,573.05"
      ],
      "correct": 3,
      "points": 12,
      "explanation": "A = P(1 + r/100)^n = 3000(1.06)^3 = 3000 x 1.191016 = $3,573.05"
    },
    {
      "question": "How long will it take for $1,500 to earn $450 in simple interest at 6% per annum?",
      "options": [
        "3 years",
        "4 years",
        "5 years",
        "6 years"
      ],
      "correct": 2,
      "points": 12,
      "explanation": "T = (SI x 100) / (P x R) = (450 x 100) / (1500 x 6) = 45000 / 9000 = 5 years"
    },
    {
      "question": "At what rate percent per annum will $2,400 amount to $2,880 in 4 years using simple interest?",
      "options": [
        "5%",
        "4%",
        "8%",
        "6%"
      ],
      "correct": 0,
      "points": 15,
      "explanation": "Interest = $2,880 - $2,400 = $480. R = (SI x 100) / (P x T) = (480 x 100) / (2400 x 4) = 48000 / 9600 = 5%"
    },
    {
      "question": "Calculate the compound interest on $4,000 for 1.5 years at 8% per annum compounded half-yearly.",
      "options": [
        "$480.00",
        "$512.00",
        "$520.50",
        "$499.46"
      ],
      "correct": 3,
      "points": 15,
      "explanation": "For half-yearly: r = 8/2 = 4%, n = 1.5 x 2 = 3 periods. A = 4000(1.04)^3 = 4000 x 1.124864 = $4,499.46. CI = $4,499.46 - $4,000 = $499.46"
    },
    {
      "question": "A person invests $10,000 at 5% per annum compound interest. After how many years will the amount exceed $11,500?",
      "options": [
        "2 years",
        "4 years",
        "5 years",
        "3 years"
      ],
      "correct": 3,
      "points": 15,
      "explanation": "Year 1: 10000 x 1.05 = $10,500. Year 2: 10500 x 1.05 = $11,025. Year 3: 11025 x 1.05 = $11,576.25. So it exceeds $11,500 after 3 years."
    },
    {
      "question": "If the compound interest on a certain sum for 2 years at 10% per annum is $420, what is the principal?",
      "options": [
        "$1,800",
        "$2,200",
        "$2,000",
        "$2,100"
      ],
      "correct": 2,
      "points": 15,
      "explanation": "CI = P[(1 + r/100)^n - 1]. So 420 = P[(1.1)^2 - 1] = P[1.21 - 1] = P(0.21). Therefore P = 420 / 0.21 = $2,000"
    }
  ]
}